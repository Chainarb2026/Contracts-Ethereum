# ============================================================
# Web3 Portfolio — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# ── Wallet ───────────────────────────────────────────────────
# Use a DEDICATED test wallet — never your main wallet
# Export private key from MetaMask: Account Details → Export Private Key
PRIVATE_KEY=0x_your_test_wallet_private_key_here

# ── RPC URLs (get free key from alchemy.com) ─────────────────
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Etherscan (etherscan.io → API Keys → Add) ────────────────
# Used for contract verification after deployment
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Gas Reporter (optional — coinmarketcap.com free tier) ─────
REPORT_GAS=true
COINMARKETCAP_API_KEY=YOUR_CMC_KEY
